# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Python (backend/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node (web/)
node_modules/
dist/
build/

# Go (token-services/, chaincode build artifacts)
*.test
*.out

# Hyperledger Fabric (network/)
network/bin/
network/config/
network/organizations/peerOrganizations/
network/organizations/ordererOrganizations/
network/organizations/fabric-ca/org1/
network/organizations/fabric-ca/org2/
network/organizations/fabric-ca/ordererOrg/
network/organizations/fabric-ca/bank*/
network/organizations/ca/
*.block
channel-artifacts/
ledger-data/

# Rendered FSC node confs (generated from core.yaml.tpl by render-owner-conf.py)
token-services/auditor/conf/core.yaml
token-services/issuer/conf/core.yaml
token-services/owner/conf/*/core.yaml

# CouchDB / DB data
*.db
*.ldb
data/

# Token services runtime state (generated by scripts, not committed)
keys/

# Secrets & certs
*.pem
*.key
*.crt
!**/crypto-config/**/*.crt
!**/crypto-config/**/*.key
.env
*.env

# Logs
*.log
logs/
# Fabric binaries + config (installed by scripts/install-fabric-tools.sh)
bin/*
!bin/sworna
config/

# Provisioning client home (token CA)
.ca-client/

# Per-portal production builds (generated)
dist-*/

# Generated at deploy time (scripts/gen-net-overrides.py, bank-network.sh)
token-services/docker-compose.net.yaml
token-services/docker-compose.bank.net.yaml
network/configtx-bank/
network/bank*-org.json
network/configtx-bank/

# Portal env files are committed config
!.env.portal-*

# TS build info
*.tsbuildinfo
