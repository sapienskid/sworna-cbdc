# ==============================================================================
# Sworna CBDC — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# Both Central Bank and Commercial Bank scripts will automatically source .env.

# Role of this machine: 'centralbank' or 'bank'
SWORNA_ROLE=centralbank

# Central Bank Host Address
# Set to the routable IP or Tailscale DNS name of the Central Bank node.
# e.g., 100.72.112.29 or centralbank.sworna.example.com
SWORNA_CB_HOST=100.72.112.29

# Auto-Admission Flag (Central Bank only)
# 1 = Automatically approve and admit incoming bank connection requests (Ideal for 30+ attendee workshops)
# 0 = Require Central Bank administrator approval via the Web Portal
SWORNA_AUTO_ADMIT=1

# Network Port Configuration
CB_PORTAL_PORT=5273
CB_BACKEND_PORT=8100
BANK_PORTAL_PORT=5173

# Optional: Tailscale reusable auth key for automated workshop machine joining
# TS_AUTHKEY=tskey-auth-kxxxxxxxxxxxxxx
